# MongoDB connection string (Atlas)
MONGODB_URI=

# Twelve Data API key (for market data)
TWELVEDATA_API_KEY=

# Finnhub API key (primary real-time quotes; Twelve Data used for historical context)
FINNHUB_API_KEY=

# Google Cloud / Vertex AI (uses Application Default Credentials)
# Run: gcloud auth application-default login
GOOGLE_CLOUD_PROJECT=stocksense-13
GOOGLE_CLOUD_LOCATION=global
VERTEX_MODEL=gemini-3.5-flash
GOOGLE_GENAI_USE_VERTEXAI=true

# JWT secret for signing auth tokens
JWT_SECRET=

# VAPID keys for Web Push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:your@email.com

# Server port
PORT=3001

# MCP server endpoint used by backend/agent/tools.js
MCP_SERVER_URL=http://localhost:8080/mcp
# Keep true for MCP-first recommendation writes, set false to force fallback path.
MCP_WRITE_ENABLED=true
# Restrict MCP writes to these collections only.
MCP_RECOMMENDATION_COLLECTION=recommendation_log
MCP_FEEDBACK_COLLECTION=recommendation_feedback

AGENT_TICKER_DELAY_MS=2000
AGENT_GEMINI_MAX_RETRIES=3
AGENT_GEMINI_RETRY_BASE_MS=5000
AGENT_SIGNAL_CACHE_MINUTES=30
