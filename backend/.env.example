# MongoDB connection string (Atlas)
MONGODB_URI=

# Twelve Data API key (for market data)
TWELVEDATA_API_KEY=

# Finnhub API key (primary real-time quotes; Twelve Data used for historical context)
FINNHUB_API_KEY=

# Cache TTLs are built-in: quotes 1m, price_context 30m, news 60m
# API usage aggregate: GET /api/debug/api-usage?hours=24

# Google Cloud / Vertex AI (uses Application Default Credentials)
# Run: gcloud auth application-default login
GOOGLE_CLOUD_PROJECT=stocksense-13
GOOGLE_CLOUD_LOCATION=global
VERTEX_MODEL=gemini-3.5-flash
GOOGLE_GENAI_USE_VERTEXAI=true

# JWT secret for signing auth tokens
JWT_SECRET=

# VAPID keys for Web Push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:your@email.com

# Server port
PORT=3001

# ─── Agent scan rate-limit tuning (optional; defaults shown) ───────────────────
# Delay between sequential Gemini calls within a scan (ms) - smooths bursts.
AGENT_TICKER_DELAY_MS=2000
# Retry attempts + base backoff (ms) when Gemini returns 429/RESOURCE_EXHAUSTED.
# Backoff grows 1×, 3×, 9× (5s → 15s → 45s by default).
AGENT_GEMINI_MAX_RETRIES=3
AGENT_GEMINI_RETRY_BASE_MS=5000
# Skip re-analyzing a ticker if it already has a signal newer than this many
# minutes (0 disables caching). Stops back-to-back scans re-spending quota.
AGENT_SIGNAL_CACHE_MINUTES=30
