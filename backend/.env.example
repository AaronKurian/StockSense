# MongoDB connection string (Atlas)
MONGODB_URI=

# Twelve Data API key (for market data)
TWELVEDATA_API_KEY=

# Google Gemini API key / service credentials
GEMINI_API_KEY=

# JWT secret for signing auth tokens
JWT_SECRET=

# VAPID keys for Web Push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:your@email.com

# Server port
PORT=3001
