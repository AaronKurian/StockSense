# MongoDB connection string (Atlas)
MONGODB_URI=

# Twelve Data API key
TWELVEDATA_API_KEY=

# Finnhub API key 
FINNHUB_API_KEY=

GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
VERTEX_MODEL=gemini-3.5-flash
GOOGLE_GENAI_USE_VERTEXAI=true

# JWT secret for signing auth tokens
JWT_SECRET=

# VAPID keys for Web Push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:your@email.com

# Server port
PORT=3001

# MCP server endpoint used by backend/agent/tools.js
MCP_SERVER_URL=http://localhost:8080/mcp
MCP_WRITE_ENABLED=true
MCP_RECOMMENDATION_COLLECTION=recommendation_log
MCP_FEEDBACK_COLLECTION=recommendation_feedback

AI_PROVIDER=gemini  #gemini, openai, openrouter, fireworks

MANUAL_AI_PROVIDER=
STRUCTURED_AI_PROVIDER=

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=nex-agi/nex-n2-pro:free

FIREWORKS_API_KEY=
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
FIREWORKS_MODEL=accounts/fireworks/models/deepseek-v4-pro

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

AI_PROVIDER_TIMEOUT_MS=60000
AI_TOOL_MAX_ITERATIONS=6

MARKET_DATA_PROVIDER=default

AGENT_TICKER_DELAY_MS=2000
AGENT_GEMINI_MAX_RETRIES=3
AGENT_GEMINI_RETRY_BASE_MS=5000
AGENT_SIGNAL_CACHE_MINUTES=30
